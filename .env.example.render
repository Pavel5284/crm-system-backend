# Render (free) - пример переменных для Blueprint (crm-api-gateway / tasks-service / notifications-service)
# Скопируй в Render Dashboard -> Environment, значения sync: false заполни реальными
# VPS (docker-compose.yml) использует .env.production - этот файл только для Render

NODE_ENV=production

# Порты - Render всегда 10000 (переопределяет Dockerfile). На VPS 3000/3001
PORT=10000
HEALTH_PORT=10000

# Neon Postgres (pooled, обязательно ?sslmode=require)
# neon.tech -> Connect -> Pooled connection
DATABASE_URL=postgresql://neondb_owner:***@ep-summer-pine-b212h3px-pooler.c-6.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# CloudAMQP RabbitMQ (Little Lemur free)
# cloudamqp.com -> AMQP URL
RABBITMQ_URL=amqps://user:pass@host/vhost

# Upstash Valkey/Redis (опционально, без него кэш/Bull отключается, сервис стартует)
# upstash.com -> TCP -> rediss://default:TOKEN@light-llama-85518.upstash.io:6379
VALKEY_URL=rediss://default:***@light-llama-85518.upstash.io:6379

# JWT - сгенерируй: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=change_me_min_32_chars_access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_min_32_chars_refresh
JWT_REFRESH_EXPIRES_IN=7d

# CORS / Frontend - для локального фронта http://localhost:3001, для прода https://твой-домен.vercel.app
CORS_ORIGIN=http://localhost:3001
FRONTEND_URL=http://localhost:3001

# --- Email ---
# На Render free SMTP 587/465 блочится (ENETUNREACH), для демо используй SKIP
# На VPS SMTP работает
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=portfolio.pavel5284@gmail.com
SMTP_PASS=wrcmdjsfnbsquhcm
SMTP_FROM=portfolio.pavel5284@gmail.com

# Отключить проверку почты для демо (register сразу верифицирован, login без письма)
# На VPS не ставь, на Render для портфолио удобно
SKIP_EMAIL_VERIFICATION=true
