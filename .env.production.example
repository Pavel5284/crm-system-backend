NODE_ENV=production
DATABASE_URL=postgresql://crmsystem:crmsystem@postgres:5432/crmsystem?schema=public
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
VALKEY_URL=redis://valkey:6379
PORT=3000
HEALTH_PORT=3001
CORS_ORIGIN=https://your-frontend-domain.example
JWT_ACCESS_SECRET=<сгенерируй командой ниже>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=<сгенерируй командой ниже>
JWT_REFRESH_EXPIRES_IN=7d
# Cloudflare Turnstile Secret Key (без него CAPTCHA на регистрации пропускается)
# TURNSTILE_SECRET_KEY=0x4AAAAAA...
# --- Демо-стенд (demo1 = ADMIN, demo2 = MANAGER, demo3 = LOGIST) ---
# DEMO_MODE=true закрывает регистрацию и разрешает вход только демо-аккаунтам.
DEMO_MODE=true
# DEMO_ENABLED=false блокирует POST /demo/reset. По умолчанию включён.
DEMO_ENABLED=true
# Пароль демо-аккаунтов (дефолт Demo12345).
# DEMO_PASSWORD=Demo12345
# Ночной автосброс (1/сутки в 00:00 MSK). false — только ручной POST /demo/reset.
DEMO_AUTO_RESET=true
DEMO_RESET_TZ=Europe/Moscow