# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://crmsystem:dbuser@localhost:5433/dbpassword?schema=public"

JWT_ACCESS_SECRET=changeme...
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=changeme...
JWT_REFRESH_EXPIRES_IN=7d

RABBITMQ_URL=changeme

# Публичный URL notifications-service (опционально): автопробуждение при таймауте RPC.
# На Render: https://crm-notifications-service.onrender.com
NOTIFICATIONS_SERVICE_HEALTH_URL=

# --- Демо-стенд (demo1/demo2/demo3, общая тестовая база) ---
# DEMO_MODE=true: регистрация закрыта (бэк отвечает 403), вход/refresh только
# для демо-аккаунтов. Для демо-стенда включай вместе с DEMO_ENABLED=true.
# DEMO_MODE=false
# DEMO_ENABLED=false полностью блокирует POST /demo/reset. По умолчанию включён.
DEMO_ENABLED=true
# Пароль всех трёх демо-аккаунтов. Дефолт Demo12345.
# DEMO_PASSWORD=Demo12345
# Ночной автосброс демо-данных: раз в сутки в 00:00 по Москве.
# DEMO_AUTO_RESET=false отключает только расписание (ручной POST /demo/reset остаётся).
# Часовой пояс расписания (IANA), дефолт — Europe/Moscow.
# DEMO_RESET_TZ=Europe/Moscow